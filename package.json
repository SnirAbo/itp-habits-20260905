{
  "name": "itp-habits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "tsx prisma/seed.ts",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.5.0",
    "@prisma/client": "^5.17.0",
    "@sentry/nextjs": "^8.16.0",
    "@upstash/rate-limit": "^1.0.0",
    "@upstash/ratelimit": "^1.0.0",
    "@upstash/redis": "^1.28.3",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "luxon": "^3.5.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.3.0",
    "postcss": "^8.4.40",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.7.0",
    "eslint-config-next": "^14.2.5",
    "husky": "^9.1.5",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "supertest": "^6.3.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
